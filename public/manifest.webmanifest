{
  "id": "radiova-app",
  "name": "Radiova Radio Player",
  "short_name": "Radiova",
  "description": "Listen to radio stations from around the world",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b1220",

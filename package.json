{
  "name": "radiova-app.github.io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Radiova official website",
  "scripts": {
    "dev": "astro dev",
    "dev:host": "astro dev --host",
    "dev:open": "astro dev --open",
    "build": "astro build",
    "build:prod": "astro build --outDir docs",
    "preview": "astro preview",
    "preview:host": "astro preview --host",
    "preview:prod": "node scripts/serve-docs.mjs",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node scripts/clean-build.mjs",
    "clean:dev": "node scripts/clean-build.mjs dist",
    "clean:prod": "node scripts/clean-build.mjs docs",
    "prebuild:prod": "node scripts/clean-build.mjs docs",
    "postbuild:prod": "node scripts/ensure-nojekyll.mjs docs"
  },
  "dependencies": {
    "astro": "^5.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "eslint": "^9.24.0",
    "prettier": "^3.5.0",
    "prettier-plugin-astro": "^0.14.1",
    "sass": "^1.86.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.1.0"
  }
}

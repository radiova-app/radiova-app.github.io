---
import AppShell from "../../layouts/AppShell.astro";

const lang = "de";
const currentPath = Astro.url.pathname;
---

<AppShell title="Support" description="Radiova Support" lang={lang} currentPath={currentPath}>
  <section class="content-page">
    <h1 class="content-page__title">Support</h1>
    <p class="content-page__text">Radiova ist ein Open-Source-Projekt. Für Support besuchen Sie bitte das GitHub-Repository oder kontaktieren Sie den Entwickler.</p>
    <p class="content-page__text">
      <a href="https://github.com/radiova-app/radiova-app.github.io/issues" target="_blank" rel="noopener noreferrer">Ein Problem auf GitHub melden</a>
    </p>
  </section>
</AppShell>

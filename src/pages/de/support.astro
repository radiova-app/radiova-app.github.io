---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Support" description="Hilfe zu Radiova erhalten" lang="de">
  <section class="page">
    <div class="container">
      <h1 class="page__title">Support</h1>
      <p class="page__text">
        Brauchen Sie Hilfe bei Radiova? Diese Seite wird Support-Informationen und
        Kontaktmöglichkeiten bereitstellen.
      </p>
      <p class="page__text">
        Support-Optionen werden vorbereitet. Schauen Sie später wieder vorbei.
      </p>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  @use "tokens" as *;

  .page {
    padding: $spacing-3xl 0;
  }

  .page__title {
    font-size: $font-size-3xl;
    font-weight: 700;
    margin-bottom: $spacing-lg;
  }

  .page__text {
    color: $color-text-muted;
    margin-bottom: $spacing-md;
    max-width: 600px;
  }
</style>

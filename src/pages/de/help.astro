---
import AppShell from "../../layouts/AppShell.astro";

const lang = "de";
const currentPath = Astro.url.pathname;
---

<AppShell title="Hilfe" description="Hilfe mit Radiova" lang={lang} currentPath={currentPath}>
  <section class="content-page">
    <h1 class="content-page__title" data-i18n="help.title">Hilfe</h1>
    <div class="content-page__body">
      <p data-i18n="help.intro">Radiova ist ein webbasierter Radio-Player. Wählen Sie einen Sender aus der Liste, um mit dem Hören zu beginnen.</p>

      <h2 data-i18n="help.gettingStarted">Erste Schritte</h2>
      <ol>
        <li data-i18n="help.step1">Öffnen Sie die Startseite</li>
        <li data-i18n="help.step2">Klicken Sie auf einen Sender, um ihn abzuspielen</li>
        <li data-i18n="help.step3">Nutzen Sie die Player-Steuerung zum Pausieren, Überspringen oder für die Lautstärke</li>
        <li data-i18n="help.step4">Markieren Sie Sender mit einem Stern, um sie zu Favoriten hinzuzufügen</li>
      </ol>

      <h2 data-i18n="help.install">Als App installieren</h2>
      <p data-i18n="help.install.text">Sie können Radiova mit der Installationsschaltfläche in der oberen Leiste als eigenständige App installieren.</p>
    </div>
  </section>
</AppShell>

<style lang="scss">
  @use "tokens" as *;

  .content-page {
    padding: $spacing-lg;
    overflow-y: auto;
    height: 100%;
  }

  .content-page__title {
    font-size: $font-size-xl;
    font-weight: 700;
    margin-bottom: $spacing-lg;
    color: $text;
  }

  .content-page__body {
    max-width: 700px;
    line-height: $line-height-base;

    p {
      margin-bottom: $spacing-md;
      color: $muted;
    }

    h2 {
      font-size: $font-size-lg;
      font-weight: 700;
      margin-top: $spacing-xl;
      margin-bottom: $spacing-md;
      color: $text;
    }

    ol, ul {
      margin-left: $spacing-lg;
      margin-bottom: $spacing-md;
    }

    li {
      margin-bottom: $spacing-xs;
      color: $muted;
    }
  }
</style>

---
import AppShell from "../layouts/AppShell.astro";

const lang = "en";
const currentPath = Astro.url.pathname;
const statusLabels = {
  available: { en: "Available", uk: "Доступно", de: "Verfügbar" },
  beta: { en: "Beta", uk: "Бета", de: "Beta" },
  "coming-soon": { en: "Coming soon", uk: "Незабаром", de: "Demnächst" },
  unavailable: { en: "Unavailable", uk: "Недоступно", de: "Nicht verfügbar" },
} as const;

type DownloadStatus = keyof typeof statusLabels;

interface DownloadItem {
  key: string;
  name: string;
  description: string;
  status: DownloadStatus;
  url?: string;
  group: string;
}

const downloads: DownloadItem[] = [
  { key: "pwa", name: "PWA", description: "Install Radiova as a standalone app", status: "available", group: "pwa" },
  { key: "chrome", name: "Chrome", description: "Chrome extension", status: "coming-soon", group: "browser" },
  { key: "edge", name: "Edge", description: "Edge extension", status: "coming-soon", group: "browser" },
  { key: "firefox", name: "Firefox", description: "Firefox extension", status: "coming-soon", group: "browser" },
  { key: "zip", name: "Manual ZIP", description: "Manual extension installation", status: "coming-soon", group: "browser" },
  { key: "android", name: "Android", description: "Android app", status: "coming-soon", group: "mobile" },
  { key: "ios", name: "iOS", description: "iOS app", status: "coming-soon", group: "mobile" },
  { key: "windows", name: "Windows", description: "Windows app", status: "coming-soon", group: "desktop" },
];

const groups = [
  { key: "pwa", title: { en: "Progressive Web App", uk: "Прогресивний веб-додаток", de: "Progressive Web App" } },
  { key: "browser", title: { en: "Browser Extensions", uk: "Розширення браузера", de: "Browser-Erweiterungen" } },
  { key: "mobile", title: { en: "Mobile Apps", uk: "Мобільні додатки", de: "Mobile Apps" } },
  { key: "desktop", title: { en: "Desktop Apps", uk: "Десктопні додатки", de: "Desktop Apps" } },
];
---

<AppShell title="Downloads" description="Download Radiova for your platform" lang={lang} currentPath={currentPath}>
  <section class="content-page">
    <h1 class="content-page__title" data-i18n="downloads.title">Downloads</h1>

    {groups.map((g) => (
      <div class="downloads-group">
        <h2 class="content-page__subtitle">{g.title.en}</h2>
        <div class="cards-grid">
          {downloads.filter((d) => d.group === g.key).map((item) => {
            const sl = statusLabels[item.status];
            return (
              <article class="card download-card" data-status={item.status}>
                <h3 class="card__title">{item.name}</h3>
                <p class="card__text">{item.description}</p>
                <span class="download-status" data-status={item.status}>{sl.en}</span>
                {item.status === "available" && item.key === "pwa" && (
                  <button id="pwa-install-page" class="card__action install-pwa-btn" type="button" data-i18n="downloads.install">Install</button>
                )}
                {item.url && (
                  <a href={item.url} class="card__action" target="_blank" rel="noopener noreferrer" data-i18n="downloads.get">Get {item.name}</a>
                )}
              </article>
            );
          })}
        </div>
      </div>
    ))}

    <section class="ios-installation">
      <h2 class="content-page__subtitle">Install on iPhone or iPad</h2>
      <p class="card__text" data-i18n="pwa.ios">On iOS, tap Share &gt; Add to Home Screen</p>
    </section>
  </section>
</AppShell>

<script src="/src/scripts/downloads.ts"></script>

<style lang="scss">
  @use "tokens" as *;

  .content-page {
    padding: $spacing-lg;
    overflow-y: auto;
    height: 100%;
  }

  .content-page__title {
    font-size: $font-size-xl;
    font-weight: 700;
    margin-bottom: $spacing-lg;
    color: $text;
  }

  .content-page__subtitle {
    font-size: $font-size-lg;
    font-weight: 700;
    margin-bottom: $spacing-lg;
    margin-top: $spacing-xl;
    color: $text;
  }

  .downloads-group {
    margin-bottom: $spacing-xl;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: $spacing-lg;
  }

  .card {
    border: 1px solid $line;
    border-radius: $radius-lg;
    padding: $spacing-lg;
    background: var(--app-panel-gradient);
  }

  .card__title {
    font-size: $font-size-lg;
    font-weight: 600;
    margin-bottom: $spacing-sm;
    color: $text;
  }

  .card__text {
    color: $muted;
    font-size: $font-size-sm;
    margin-bottom: $spacing-md;
  }

  .download-card {
    display: grid;
    gap: $spacing-sm;
  }

  .download-status {
    display: inline-block;
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid $line;
    width: fit-content;
    color: $muted;
    white-space: nowrap;

    &[data-status="available"] {
      border-color: $ok;
      color: $ok;
    }

    &[data-status="beta"] {
      border-color: $accent;
      color: $accent;
    }
  }

  .card__action {
    font-size: $font-size-sm;
    padding: $spacing-xs $spacing-md;
    border: 1px solid $line;
    border-radius: $radius-md;
    background: var(--app-control-bg);
    color: $text;
    cursor: pointer;
    text-decoration: none;

    &:hover {
      border-color: $accent;
      color: $accent;
      text-decoration: none;
    }
  }

  .ios-installation {
    border-top: 1px solid $line;
    margin-top: $spacing-xl;
  }
</style>
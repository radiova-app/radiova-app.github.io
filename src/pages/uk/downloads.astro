---
import AppShell from "../../layouts/AppShell.astro";

const lang = "uk";
const currentPath = Astro.url.pathname;
---

<AppShell title="Завантаження" description="Завантажте Radiova на свою платформу" lang={lang} currentPath={currentPath}>
  <section class="content-page">
    <h1 class="content-page__title">Завантаження</h1>
    <p class="content-page__text">Завантажте Radiova на свою платформу або встановіть як веб-додаток.</p>

    <button id="pwa-install-page" class="action-btn" type="button" data-i18n="downloads.install">Встановити</button>

    <section class="ios-installation">
      <h2>iPhone або iPad</h2>
      <p data-i18n="pwa.ios">На iOS: Поділитися &gt; На головний екран</p>
    </section>
  </section>
</AppShell>

<script src="/src/scripts/downloads.ts"></script>

<style lang="scss">
  @use "tokens" as *;

  .content-page {
    padding: $spacing-lg;
    overflow-y: auto;
    height: 100%;
  }

  .content-page__title {
    font-size: $font-size-xl;
    font-weight: 700;
    margin-bottom: $spacing-lg;
    color: $text;
  }

  .content-page__text,
  .ios-installation p {
    color: $muted;
  }

  .action-btn {
    margin-top: $spacing-md;
    padding: $spacing-sm $spacing-md;
    border: 1px solid $line;
    border-radius: $radius-md;
    background: var(--app-control-bg);
    color: $text;
    cursor: pointer;
  }

  .ios-installation {
    border-top: 1px solid $line;
    margin-top: $spacing-xl;
  }

  .ios-installation h2 {
    font-size: $font-size-lg;
    margin: $spacing-xl 0 $spacing-md;
  }
</style>
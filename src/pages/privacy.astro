---
import AppShell from "../layouts/AppShell.astro";

const lang = "en";
const currentPath = Astro.url.pathname;
---

<AppShell title="Privacy Policy" description="Radiova privacy policy" lang={lang} currentPath={currentPath}>
  <section class="content-page">
    <h1 class="content-page__title" data-i18n="privacy.title">Privacy Policy</h1>
    <p class="content-page__text" data-i18n="privacy.intro">Radiova respects your privacy. All data is stored locally in your browser using IndexedDB. No personal information is collected, transmitted, or shared.</p>

    <h2 class="content-page__subtitle" data-i18n="privacy.data">What data we store</h2>
    <ul class="content-page__list">
      <li data-i18n="privacy.data.favorites">Your favorite stations</li>
      <li data-i18n="privacy.data.history">Listen history</li>
      <li data-i18n="privacy.data.settings">App settings (language, theme, volume)</li>
      <li data-i18n="privacy.data.custom">Custom playlists</li>
      <li data-i18n="privacy.data.offline">Offline app shell and playlist cache</li>
    </ul>

    <h2 class="content-page__subtitle" data-i18n="privacy.thirdParty">Third-party services</h2>
    <p class="content-page__text" data-i18n="privacy.thirdParty.text">Radiova fetches station data from the open radiova-stations GitHub repository. Stream audio is played directly from source URLs. No third-party analytics or tracking is used.</p>

    <h2 class="content-page__subtitle" data-i18n="privacy.reset">Reset local data</h2>
    <p class="content-page__text" data-i18n="privacy.reset.text">You can clear all locally stored data at any time using the button below.</p>
    <button class="action-btn privacy-settings-action" type="button" data-i18n="privacy.settings.action">Privacy settings</button>
    <button id="reset-data-btn" class="action-btn" type="button" data-i18n="privacy.reset.action">Reset all data</button>
    <p id="reset-status" class="status" role="status"></p>
  </section>
</AppShell>

<script src="/src/scripts/reset-data.ts"></script>

<style lang="scss">
  @use "tokens" as *;

  .content-page {
    padding: $spacing-lg;
    overflow-y: auto;
    height: 100%;
  }

  .content-page__title {
    font-size: $font-size-xl;
    font-weight: 700;
    margin-bottom: $spacing-lg;
    color: $text;
  }

  .content-page__subtitle {
    font-size: $font-size-lg;
    font-weight: 700;
    margin: $spacing-xl 0 $spacing-md;
    color: $text;
  }

  .content-page__text {
    color: $muted;
    margin-bottom: $spacing-md;
    max-width: 700px;
  }

  .content-page__list {
    margin-left: $spacing-lg;
    margin-bottom: $spacing-md;

    li {
      color: $muted;
      margin-bottom: $spacing-xs;
    }
  }

  .action-btn {
    padding: $spacing-sm $spacing-md;
    border: 1px solid $line;
    border-radius: $radius-md;
    background: var(--app-control-bg);
    color: $text;
    cursor: pointer;

    &:hover {
      border-color: $accent;
    }
  }

  .status {
    margin-top: $spacing-sm;
    color: $muted;
    font-size: $font-size-sm;
  }
</style>

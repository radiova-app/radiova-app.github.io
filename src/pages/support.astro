---
import AppShell from "../layouts/AppShell.astro";

const lang = "en";
const currentPath = Astro.url.pathname;
---

<AppShell title="Support" description="Radiova support" lang={lang} currentPath={currentPath}>
  <section class="content-page">
    <h1 class="content-page__title">Support</h1>
    <p class="content-page__text">Radiova is an open-source project. For support, please visit the GitHub repository or contact the developer.</p>
    <p class="content-page__text">
      <a href="https://github.com/radiova-app/radiova-app.github.io/issues" target="_blank" rel="noopener noreferrer">Report an issue on GitHub</a>
    </p>
  </section>
</AppShell>

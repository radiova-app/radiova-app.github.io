---
import AppShell from "../layouts/AppShell.astro";

const lang = "en";
const currentPath = Astro.url.pathname;
---

<AppShell title="About" description="About Radiova" lang={lang} currentPath={currentPath}>
  <section class="content-page">
    <h1 class="content-page__title" data-i18n="about.title">About Radiova</h1>
    <div class="content-page__body">
      <p data-i18n="about.intro">Radiova is a cross-platform radio player that lets you listen to stations from around the world.</p>

      <h2 data-i18n="playlists.title">Playlists</h2>
      <p data-i18n="about.playlists">Default playlists are curated for Ukrainian, English, German, and Global stations. All data is fetched from the open radiova-stations repository.</p>

      <h2 data-i18n="privacy.title">Privacy</h2>
      <p data-i18n="about.privacy">All user data is stored locally in your browser.</p>

      <h2>Links</h2>
      <ul>
        <li><a href="https://github.com/radiova-app/radiova-app.github.io">Website source</a></li>
        <li><a href="https://github.com/radiova-app/radiova-stations">Station data</a></li>
        <li><a href="https://github.com/radiova-app/radiova-releases">Releases</a></li>
      </ul>
    </div>
  </section>
</AppShell>

<style lang="scss">
  @use "tokens" as *;

  .content-page {
    padding: $spacing-lg;
    overflow-y: auto;
    height: 100%;
  }

  .content-page__title {
    font-size: $font-size-xl;
    font-weight: 700;
    margin-bottom: $spacing-lg;
    color: $text;
  }

  .content-page__body {
    max-width: 700px;
    line-height: $line-height-base;

    p {
      margin-bottom: $spacing-md;
      color: $muted;
    }

    h2 {
      font-size: $font-size-lg;
      font-weight: 700;
      margin-top: $spacing-xl;
      margin-bottom: $spacing-md;
      color: $text;
    }

    ul {
      margin-left: $spacing-lg;
      margin-bottom: $spacing-md;
    }

    li {
      margin-bottom: $spacing-xs;
      color: $muted;
    }

    a {
      color: $accent;
    }
  }
</style>

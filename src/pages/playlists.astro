---
import AppShell from "../layouts/AppShell.astro";
import { SITE, PLAYLIST_LABELS } from "../config/site";

const lang = "en";
const currentPath = Astro.url.pathname;
const baseUrl = SITE.stationsUrl;
const locales = ["uk", "en", "de", "global", "all"] as const;
---

<AppShell
  title="Playlists"
  description="Browse Radiova default playlists"
  lang={lang}
  currentPath={currentPath}
>
  <section class="content-page">
    <h1 class="content-page__title" data-i18n="playlists.title">Playlists</h1>

    <div class="playlists-grid" id="playlists-page">
      {
        locales.map((locale) => {
          const label = PLAYLIST_LABELS[locale];
          return (
            <article class="card playlist-card" data-locale={locale}>
              <h2 class="card__title">{label.en}</h2>
              <p class="card__text" id={"playlist-info-" + locale}>
                <span data-i18n="playlists.neverUpdated">Not yet loaded</span>
              </p>
              <div class="playlist-card__actions">
                <a
                  href={"/" + (lang === "en" ? "" : lang + "/")}
                  class="card__action"
                  data-i18n="playlists.open"
                >
                  Open
                </a>
                <a
                  href={baseUrl + "/playlists/" + locale + ".m3u"}
                  class="card__action"
                  download
                  data-i18n="playlists.download"
                >
                  Download M3U
                </a>
                <button
                  class="card__action copy-url-btn"
                  data-url={baseUrl + "/playlists/" + locale + ".m3u"}
                  type="button"
                  data-i18n="playlists.copyUrl"
                >
                  Copy URL
                </button>
              </div>
            </article>
          );
        })
      }
    </div>

    <section class="custom-playlists">
      <h2 class="content-page__subtitle" data-i18n="custom.title">Your playlists</h2>
      <form id="custom-playlist-form" class="custom-playlist-form">
        <label class="sr-only" for="custom-playlist-name" data-i18n="custom.name"
          >Playlist name</label
        >
        <input
          id="custom-playlist-name"
          type="text"
          maxlength="80"
          data-i18n-placeholder="custom.name"
          placeholder="Playlist name"
        />
        <button class="action-btn" type="submit" data-i18n="custom.createAction"
          >Create playlist</button
        >
      </form>
      <div class="custom-actions">
        <button id="import-m3u-btn" class="action-btn" type="button" data-i18n="custom.import"
          >Import M3U</button
        >
        <input type="file" id="import-m3u-input" accept=".m3u,.m3u8" class="is-hidden" />
      </div>
      <p id="custom-playlists-status" class="custom-playlists-status" role="status"></p>
      <div id="custom-playlists-list" class="custom-playlists-list"></div>
    </section>
  </section>
</AppShell>

<script src="/src/scripts/playlists.ts"></script>

<style lang="scss">
  @use "tokens" as *;

  .content-page {
    padding: $spacing-lg;
    overflow-y: auto;
    height: 100%;
  }

  .content-page__title {
    font-size: $font-size-xl;
    font-weight: 700;
    margin-bottom: $spacing-lg;
    color: $text;
  }

  .content-page__subtitle {
    font-size: $font-size-lg;
    font-weight: 700;
    margin-bottom: $spacing-lg;
    margin-top: $spacing-xl;
    color: $text;
  }

  .content-page__text {
    color: $muted;
    margin-bottom: $spacing-md;
  }

  .playlists-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: $spacing-lg;
    margin-bottom: $spacing-2xl;
  }

  .playlist-card {
    display: grid;
    gap: $spacing-md;
  }

  .card {
    border: 1px solid $line;
    border-radius: $radius-lg;
    padding: $spacing-lg;
    background: var(--app-panel-gradient);
  }

  .card__title {
    font-size: $font-size-lg;
    font-weight: 600;
    margin-bottom: $spacing-sm;
    color: $text;
  }

  .card__text {
    color: $muted;
    font-size: $font-size-sm;
    margin-bottom: $spacing-md;
  }

  .playlist-card__actions {
    display: flex;
    gap: $spacing-xs;
    flex-wrap: wrap;
  }

  .card__action {
    font-size: $font-size-sm;
    padding: $spacing-xs $spacing-md;
    border: 1px solid $line;
    border-radius: $radius-md;
    background: var(--app-control-bg);
    color: $text;
    cursor: pointer;
    text-decoration: none;

    &:hover {
      border-color: $accent;
      color: $accent;
      text-decoration: none;
    }
  }

  .custom-playlists {
    border-top: 1px solid $line;
    padding-top: $spacing-xl;
  }

  .custom-actions {
    display: flex;
    gap: $spacing-md;
    margin-top: $spacing-md;
  }

  .custom-playlist-form {
    display: flex;
    gap: $spacing-sm;
    align-items: center;
  }

  .custom-playlist-form input {
    min-width: 0;
    flex: 1;
    height: 36px;
    padding: 0 $spacing-sm;
    border: 1px solid $line;
    border-radius: $radius-md;
    background: var(--app-control-bg);
    color: $text;
  }

  .custom-playlists-status {
    min-height: 1.5em;
    margin-top: $spacing-sm;
    color: $muted;
    font-size: $font-size-sm;
  }

  .custom-playlists-list {
    display: grid;
    gap: $spacing-sm;
  }

  .custom-playlist-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: $spacing-md;
    padding: $spacing-md;
    border: 1px solid $line;
    border-radius: $radius-md;
    background: var(--app-control-bg-soft);
  }

  @media (max-width: $breakpoint-sm) {
    .custom-playlist-form,
    .custom-playlist-item {
      align-items: stretch;
      flex-direction: column;
    }
  }

  .action-btn {
    padding: $spacing-sm $spacing-md;
    border: 1px solid $line;
    border-radius: $radius-md;
    background: var(--app-control-bg);
    color: $text;
    cursor: pointer;

    &:hover {
      border-color: $accent;
    }
  }
</style>

---
import AppShell from "../layouts/AppShell.astro";

const lang = "en";
const currentPath = Astro.url.pathname;
---

<AppShell title="Help" description="Radiova help and support" lang={lang} currentPath={currentPath}>
  <section class="content-page">
    <h1 class="content-page__title" data-i18n="help.title">Help</h1>
    <div class="content-page__body">
      <p data-i18n="help.intro">Radiova is a web-based radio player. Select a station from the list to start listening.</p>

      <h2 data-i18n="help.gettingStarted">Getting started</h2>
      <ol>
        <li data-i18n="help.step1">Open the Home page</li>
        <li data-i18n="help.step2">Click a station to play</li>
        <li data-i18n="help.step3">Use the player controls to pause, skip, or adjust volume</li>
        <li data-i18n="help.step4">Star stations to add them to Favorites</li>
      </ol>

      <h2 data-i18n="help.install">Install as app</h2>
      <p data-i18n="help.install.text">You can install Radiova as a standalone app using the install button in the top bar.</p>
    </div>
  </section>
</AppShell>

<style lang="scss">
  @use "tokens" as *;

  .content-page {
    padding: $spacing-lg;
    overflow-y: auto;
    height: 100%;
  }

  .content-page__title {
    font-size: $font-size-xl;
    font-weight: 700;
    margin-bottom: $spacing-lg;
    color: $text;
  }

  .content-page__body {
    max-width: 700px;
    line-height: $line-height-base;

    p {
      margin-bottom: $spacing-md;
      color: $muted;
    }

    h2 {
      font-size: $font-size-lg;
      font-weight: 700;
      margin-top: $spacing-xl;
      margin-bottom: $spacing-md;
      color: $text;
    }

    ol, ul {
      margin-left: $spacing-lg;
      margin-bottom: $spacing-md;
    }

    li {
      margin-bottom: $spacing-xs;
      color: $muted;
    }
  }
</style>

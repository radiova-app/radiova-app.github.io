---
export interface Props {
  name: string;
  description: string;
  status: "available" | "coming-soon" | "not-available";
  downloadUrl?: string;
}

const { name, description, status, downloadUrl } = Astro.props;
---

<article class="platform-card">
  <h3 class="platform-card__name">{name}</h3>
  <p class="platform-card__description">{description}</p>
  <p class="platform-card__status">
    {status === "available" && "Available"}
    {status === "coming-soon" && "Coming soon"}
    {status === "not-available" && "Not available"}
  </p>
  {
    downloadUrl && (
      <a href={downloadUrl} class="platform-card__download">
        Download
      </a>
    )
  }
</article>

<style lang="scss">
  @use "tokens" as *;

  .platform-card {
    border: $border-width $border-style $border-color;
    border-radius: $radius-md;
    padding: $spacing-lg;
    background: $color-surface;
  }

  .platform-card__name {
    font-size: $font-size-lg;
    font-weight: 600;
    margin-bottom: $spacing-sm;
  }

  .platform-card__description {
    color: $color-text-muted;
    font-size: $font-size-sm;
    margin-bottom: $spacing-md;
  }

  .platform-card__status {
    font-size: $font-size-sm;
    margin-bottom: $spacing-md;
  }

  .platform-card__download {
    display: inline-block;
    padding: $spacing-sm $spacing-md;
    background: $color-accent;
    color: #fff;
    border-radius: $radius-sm;
    font-size: $font-size-sm;

    &:hover {
      background: $color-accent-hover;
      text-decoration: none;
    }
  }
</style>

---
export interface Props {
  name: string;
  version?: string;
  url?: string;
  size?: string;
  checksum?: string;
  available: boolean;
}

const { name, version, url, size, checksum, available } = Astro.props;
---

<article class="download-card">
  <h3 class="download-card__name">{name}</h3>
  {version && <p class="download-card__version">Version: {version}</p>}
  {size && <p class="download-card__size">Size: {size}</p>}
  {checksum && <p class="download-card__checksum">SHA256: {checksum}</p>}
  {
    available && url ? (
      <a href={url} class="download-card__link">
        Download
      </a>
    ) : (
      <p class="download-card__unavailable">Not yet available</p>
    )
  }
</article>

<style lang="scss">
  @use "tokens" as *;

  .download-card {
    border: $border-width $border-style $border-color;
    border-radius: $radius-md;
    padding: $spacing-lg;
    background: $color-surface;
  }

  .download-card__name {
    font-size: $font-size-lg;
    font-weight: 600;
    margin-bottom: $spacing-sm;
  }

  .download-card__version,
  .download-card__size,
  .download-card__checksum {
    font-size: $font-size-sm;
    color: $color-text-muted;
    margin-bottom: $spacing-xs;
  }

  .download-card__link {
    display: inline-block;
    margin-top: $spacing-md;
    padding: $spacing-sm $spacing-md;
    background: $color-accent;
    color: #fff;
    border-radius: $radius-sm;
    font-size: $font-size-sm;

    &:hover {
      background: $color-accent-hover;
      text-decoration: none;
    }
  }

  .download-card__unavailable {
    margin-top: $spacing-md;
    color: $color-text-muted;
    font-size: $font-size-sm;
    font-style: italic;
  }
</style>

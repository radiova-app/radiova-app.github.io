---
export interface Props {
  lang?: string;
}

const { lang = "en" } = Astro.props;
const currentPath = Astro.url.pathname;

const dePath = currentPath === "/" ? "/de/" : `/de${currentPath}`;
const ukPath = currentPath === "/" ? "/uk/" : `/uk${currentPath}`;
const enPath = currentPath.replace(/^\/(de|uk)/, "") || "/";
---

<nav class="language-switcher" aria-label="Language switcher">
  <a href={enPath} class="language-switcher__link" aria-current={lang === "en" ? "true" : undefined}
    >EN</a
  >
  <span class="language-switcher__sep" aria-hidden="true">|</span>
  <a href={dePath} class="language-switcher__link" aria-current={lang === "de" ? "true" : undefined}
    >DE</a
  >
  <span class="language-switcher__sep" aria-hidden="true">|</span>
  <a href={ukPath} class="language-switcher__link" aria-current={lang === "uk" ? "true" : undefined}
    >UK</a
  >
</nav>

<style lang="scss">
  @use "tokens" as *;

  .language-switcher {
    display: flex;
    align-items: center;
    gap: $spacing-xs;
  }

  .language-switcher__link {
    font-size: $font-size-sm;
    color: $color-text-muted;

    &[aria-current="true"] {
      color: $color-accent;
      font-weight: 600;
    }
  }

  .language-switcher__sep {
    color: $color-text-muted;
    font-size: $font-size-sm;
  }
</style>
